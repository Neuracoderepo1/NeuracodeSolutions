# Publishable/anon keys are safe to expose client-side by design, but we
# still keep real values out of the repo as a matter of hygiene — copy
# this file to .env.local and fill in the real project values.

NEXT_PUBLIC_SUPABASE_URL=https://ivcweujfzdwmkztjczln.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the service role key in a NEXT_PUBLIC_* variable, in
# .env.local, or anywhere reachable from app/ or lib/. It bypasses RLS
# entirely. If it's ever needed (it shouldn't be, for this app —
# transition_opportunity() is SECURITY DEFINER and doesn't need it),
# it belongs only in a server-only deployment secret, never checked in.
